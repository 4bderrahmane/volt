# Copy to .env before the first `docker compose up`, then set every value.
#
# Every password and secret below is required: compose.yml declares them
# with `${VAR:?...}`, so a missing or empty value aborts `docker compose up`

PG_CATALOG_USER=catalog_user
PG_CATALOG_PASSWORD=change-me
PG_ORDER_USER=order_user
PG_ORDER_PASSWORD=change-me

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
ORDER_CLIENT_SECRET=dev-only-not-a-real-secret
