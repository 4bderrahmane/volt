# Copy to .env before the first `docker compose up`.
PG_CATALOG_USER=catalog_user
PG_CATALOG_PASSWORD=change-me
PG_ORDER_USER=order_user
PG_ORDER_PASSWORD=change-me

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Client secret for the `volt-order` confidential client — the machine identity
# order-service uses to call catalog's /internal/v1/stock/** endpoints (ADR-0004).
#
# The value in infra/keycloak/realm-volt.json is a development placeholder and is
# committed on purpose so the stack starts on a clean machine. It grants access to
# nothing outside this compose network. Do not reuse the pattern for anything real.
ORDER_CLIENT_SECRET=dev-only-not-a-real-secret
