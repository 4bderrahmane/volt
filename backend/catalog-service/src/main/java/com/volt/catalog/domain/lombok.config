# =============================================================================
# Domain-layer Lombok rules — ADR-0008.
#
# WHY THIS FILE EXISTS, and not an ArchUnit rule:
#
# Lombok's annotations are RetentionPolicy.SOURCE. They are erased by the
# compiler and never appear in a .class file. ArchUnit reads bytecode, so it
# is structurally incapable of seeing @Data on a domain entity — a rule of the
# form "domain should not depend on lombok.." compiles, runs, passes, and
# guards nothing at all.
#
# lombok.config runs inside the compiler, where the annotations still exist,
# so it is the only mechanism that can enforce these. Violations fail the build
# with a clear message at the offending line.
# =============================================================================

# This file adds to the project-wide config above it rather than replacing it.
config.stopBubbling = false

# ---------------------------------------------------------------------------
# @Data — banned. It bundles @Setter, @EqualsAndHashCode and @RequiredArgsConstructor:
#   * setters reopen every field, so any invariant the aggregate protects can be
#     bypassed by a caller who never reads the class;
#   * generated equals/hashCode compare every field, which is value equality.
#     Entities are equal by id (ADR-0001) — two snapshots of one order taken
#     either side of a status change would otherwise compare as different orders,
#     and a stale copy becomes unfindable in a HashSet holding the fresh one.
# ---------------------------------------------------------------------------
lombok.data.flagUsage = ERROR

# @Value — banned. Makes the class final and every field final, which is the
# right shape for a value object; but value objects here are records, which do
# the same thing in the language rather than in an annotation processor.
lombok.value.flagUsage = ERROR

# @Setter — banned. State changes go through named behaviour methods that can
# validate: cart.changeQuantity(n) rejects n < 1; setQuantity(n) accepts it and
# the failure surfaces later as a CHECK constraint violation at flush time,
# with no useful stack trace.
lombok.setter.flagUsage = ERROR

# @EqualsAndHashCode — banned. See @Data. The hand-written versions are by id
# with a constant hash, which is deliberate and not something Lombok can express.
lombok.equalsAndHashCode.flagUsage = ERROR

# @AllArgsConstructor — banned. Its parameter order follows field declaration
# order, so reordering two fields of the same type silently reorders every call
# site and still compiles. Written-out constructors turn that into a compile error.
lombok.allArgsConstructor.flagUsage = ERROR

# @Builder — banned on entities: it bypasses the static factories (Product.create,
# Reservation.open, Order.place) that establish invariants, so it can build an
# object the domain considers impossible. Use it freely in test fixtures and in
# infrastructure DTOs, which live outside this directory.
lombok.builder.flagUsage = ERROR

# ---------------------------------------------------------------------------
# Permitted: @Getter and @ToString. Pure boilerplate, no semantics of their own.
# Note the per-field @Getter(AccessLevel.NONE) on the aggregate collections —
# without it the generated accessor hands out the live ArrayList.
# ---------------------------------------------------------------------------
