# =============================================================================
# Project-wide Lombok configuration.
#
# lombok.config applies to the whole directory tree it sits in. A second,
# stricter file lives under src/main/java/com/volt/<service>/domain/ and
# tightens these rules for the domain layer only.
# =============================================================================

# Nothing above this directory should influence the build.
config.stopBubbling = true

# Marks generated members with @lombok.Generated so JaCoCo measures handwritten
# behaviour instead of generated accessors.
lombok.addLombokGeneratedAnnotation = true

# @Autowired field injection is already forbidden by HexagonalArchitectureTest.
# Lombok can create the same coupling through @RequiredArgsConstructor on a
# class with non-final fields, which ArchUnit cannot see — so prefer explicit
# final fields and let this stay visible in review.
lombok.anyConstructor.addConstructorProperties = false
#lombok.nonNull.exceptionType =
